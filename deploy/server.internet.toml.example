# Internet-facing native relay. Noise XX protects both listeners; signed mode
# limits admission to devices issued by the configured offline CA.
[listeners]
publisher = "0.0.0.0:8900"
viewer = "0.0.0.0:8899"

[retention]
bytes_per_stream = 104857600
seconds_per_stream = 86400

[access]
mode = "signed"
authority_file = "/etc/glacialcast/relay-ca.pub"
revocations_file = "/etc/glacialcast/relay.crl"
