[Unit]
Description=GlacialCast encrypted screen relay
Documentation=https://github.com/0typos/glacialcast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glacialcast
Group=glacialcast
UMask=0077
Environment=RUST_LOG=glacialcast_relay=info

# systemd creates and owns both directories, so installing this unit needs no
# mkdir and no chown. %S is the state root, which is /var/lib for a system unit.
ConfigurationDirectory=glacialcast
ConfigurationDirectoryMode=0750
StateDirectory=glacialcast
StateDirectoryMode=0700

# No --config here on purpose: the relay finds /etc/glacialcast/relay.toml by
# itself. Point it somewhere else without editing this unit by dropping in
#   [Service]
#   Environment=GLACIALCAST_CONFIG=/somewhere/else.toml
# under /etc/systemd/system/gcrelay.service.d/.
#
# The file must be a private regular file with mode 0600. A path given
# explicitly that is not there fails startup rather than falling back to
# defaults, which could quietly expose a public-admission relay.
ExecStart=/usr/local/bin/gcrelay \
    --viewer-addr 0.0.0.0:8899 \
    --publisher-addr 0.0.0.0:8900 \
    --data-dir %S/glacialcast \
    --retention-bytes 100MiB \
    --retention-seconds 86400
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
LimitNOFILE=8192

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
