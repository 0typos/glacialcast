{
	servers {
		max_header_size 32KB
	}
}

{$GLACIALCAST_DOMAIN} {
	reverse_proxy 127.0.0.1:8899 {
		# Replace the forwarded chain with the address this connection really
		# came from, rather than appending to whatever the client sent. The
		# relay reads the rightmost entry and is correct either way; pinning it
		# here means a client cannot put anything in the header at all, so the
		# access log above records one address per request and it is the real
		# one. Remove this only if you put another trusted proxy in front, and
		# then make sure the relay still sees exactly one appended hop.
		header_up X-Forwarded-For {remote_host}
		health_uri /health/ready
		health_interval 30s
		health_timeout 5s
	}

	log {
		output file /var/log/caddy/glacialcast-access.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
