[Unit]
Description=GlacialCast encrypted screen publisher
Documentation=https://github.com/0typos/glacialcast
# The publisher captures the running graphical session, so it starts with that
# session and stops with it. Install it as a user unit, not a system unit:
#   mkdir -p ~/.config/systemd/user
#   cp gcpub.service ~/.config/systemd/user/
#   systemctl --user enable --now gcpub.service
PartOf=graphical-session.target
After=graphical-session.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
UMask=0077
Environment=RUST_LOG=glacialcast_publisher=info

# For a user unit systemd puts these under $XDG_CONFIG_HOME and
# $XDG_STATE_HOME, which is exactly where the publisher looks for its config
# and keeps its native identity. Nothing to create by hand.
ConfigurationDirectory=glacialcast
ConfigurationDirectoryMode=0700
StateDirectory=glacialcast
StateDirectoryMode=0700

# --foreground because systemd supervises this process, not the publisher's own
# daemoniser; without it the unit would exit as soon as it detached.
#
# No --config: the publisher finds $XDG_CONFIG_HOME/glacialcast/client.toml on
# its own, falling back to /etc/glacialcast/client.toml. Point it elsewhere with
# a drop-in under ~/.config/systemd/user/gcpub.service.d/:
#   [Service]
#   Environment=GLACIALCAST_CONFIG=%h/somewhere/else.toml
#
# Frame rate, cursor rate, and frame size are left at their defaults, which are
# the values the bandwidth and cursor gates measure.
#
# Every output is published as its own end-to-end encrypted stream. Set
# all_monitors = false in client.toml to publish only the primary one.
ExecStart=/usr/local/bin/gcpub \
    --foreground \
    --ingest-addr 127.0.0.1:8900 \
    --capture wayland \
    --portal-source monitor \
    --all-monitors
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
