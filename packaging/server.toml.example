# GlacialCast native relay configuration.
# Copy to /etc/glacialcast/relay.toml and chmod 600.

[listeners]
publisher = "0.0.0.0:8900"
viewer = "0.0.0.0:8899"

[retention]
bytes_per_stream = 104857600
seconds_per_stream = 86400

# Public mode exposes stream names and accepts any Noise-authenticated peer.
[access]
mode = "public"

# For CA admission, replace [access] above with:
# [access]
# mode = "signed"
# authority_file = "/etc/glacialcast/relay-ca.pub"
# revocations_file = "/etc/glacialcast/relay.crl"
