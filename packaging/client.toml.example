# GlacialCast publisher configuration.
# Copy to ~/.config/glacialcast/client.toml and chmod 600.

client_id = "workstation"
display_name = "Workstation"
all_monitors = true

# Newly approved viewers may receive retained group keys within both bounds.
history_bytes = 104857600
history_seconds = 86400

# Pin the relay Noise identity on first setup when it is distributed out of
# band. Without an explicit pin, gcpub uses trust on first use and rejects any
# later key change.
# ingest_server_key = "URL_SAFE_BASE64_RELAY_NOISE_KEY"

# A signed relay additionally needs a publisher credential:
# gcpub --native-credential ~/.config/glacialcast/publisher.cred
